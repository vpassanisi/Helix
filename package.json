{
  "name": "helix-vscode",
  "displayName": "Helix",
  "description": "A VS Code sidebar Webview UI for Helix.",
  "version": "0.0.97",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vpassanisi/DeepBlue.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/extension-icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "type": "module",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "Helix",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.sidebar",
          "name": "Helix",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openSidebar",
        "title": "Helix: Open Sidebar"
      },
      {
        "command": "dsh.newSession",
        "title": "Helix: New Session"
      },
      {
        "command": "dsh.captureNextProviderRequest",
        "title": "Helix: Capture Next Provider Request Body"
      },
      {
        "command": "dsh.askSelection",
        "title": "Helix: Ask About Selection"
      },
      {
        "command": "dsh.selectBrowserElements",
        "title": "Helix: Select Browser Elements"
      }
    ],
    "configuration": {
      "title": "Helix",
      "properties": {
        "deepseekHarness.provider": {
          "type": "string",
          "default": "deepseek-official",
          "description": "Harness model provider route."
        },
        "deepseekHarness.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "Selected Harness model identifier. Managed by the sidebar model picker."
        },
        "deepseekHarness.contextWindow": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Selected model context window in tokens. Managed by the sidebar model picker."
        },
        "deepseekHarness.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional DeepSeek-compatible API base URL. Empty uses the provider default."
        },
        "deepseekHarness.sandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "enumItemLabels": [
            "Read-only",
            "Workspace write",
            "Danger full access"
          ],
          "default": "workspace-write",
          "description": "Sandbox permission mode for DSH sessions."
        },
        "deepseekHarness.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP servers attached to the DSH runtime. Secret environment values are stored in VS Code SecretStorage.",
          "items": {
            "type": "object",
            "properties": {
              "serverName": {
                "type": "string",
                "description": "Unique MCP tool namespace."
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "streamable-http"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "envKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "deepseekHarness.otelTracing": {
          "type": "object",
          "default": {
            "enabled": false,
            "serviceName": "helix",
            "endpoints": [],
            "capturePrompts": false,
            "captureResponses": false,
            "captureToolArguments": false,
            "maxContentLength": 8192
          },
          "additionalProperties": false,
          "description": "Optional OTLP trace export through the bundled DSH tracing plugin. Every trace is sent to each configured destination. Content capture is off by default.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "serviceName": {
              "type": "string",
              "default": "helix"
            },
            "endpoints": {
              "type": "array",
              "default": [],
              "description": "Each finished trace is exported to every listed destination.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "default": "",
                    "description": "Complete HTTP traces URL including /v1/traces, or a gRPC target such as collector:4317."
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "http/protobuf",
                      "grpc"
                    ],
                    "default": "http/protobuf"
                  },
                  "headersEnv": {
                    "type": "string",
                    "default": "",
                    "description": "Optional environment variable containing comma-separated key=value headers."
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 120000,
                    "default": 5000
                  }
                }
              }
            },
            "capturePrompts": {
              "type": "boolean",
              "default": false
            },
            "captureResponses": {
              "type": "boolean",
              "default": false
            },
            "captureToolArguments": {
              "type": "boolean",
              "default": false
            },
            "maxContentLength": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65536,
              "default": 8192
            }
          }
        },
        "deepseekHarness.plugins": {
          "type": "array",
          "default": [],
          "description": "Additional local DSH plugin bundles. Only add modules you trust; enabled plugins execute inside the DSH runtime.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "path": {
                "type": "string",
                "description": "Absolute path to a local JavaScript bundle. Relative paths resolve from the Helix extension folder."
              },
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "config": {
                "type": "object",
                "additionalProperties": true,
                "default": {}
              }
            }
          }
        },
        "deepseekHarness.dshBin": {
          "type": "string",
          "default": "",
          "description": "Optional path to a dsh CLI module. Empty uses the matching bundled @deepseek-ai/dsh runtime."
        },
        "deepseekHarness.dshHome": {
          "type": "string",
          "default": "",
          "description": "Optional Harness home directory. Empty inherits the normal Harness home."
        },
        "deepseekHarness.maxSelectionCharacters": {
          "type": "number",
          "default": 32000,
          "minimum": 1000,
          "description": "Maximum selected editor characters sent as prompt context."
        },
        "deepseekHarness.maxBrowserContextCharacters": {
          "type": "number",
          "default": 32000,
          "minimum": 1000,
          "maximum": 1000000,
          "description": "Maximum HTML and CSS characters sent across browser element attachments per prompt."
        },
        "deepseekHarness.experimentalSkillPicker": {
          "type": "boolean",
          "default": false,
          "tags": [
            "experimental"
          ],
          "description": "Enable the experimental Skills drawer and decisions connection controls. When off, skill routing and preloading are disabled; the agent can still discover and load skills normally."
        },
        "deepseekHarness.decisions": {
          "type": "object",
          "default": {
            "enabled": false,
            "useMainConnection": true,
            "format": "typesafe",
            "baseUrl": "",
            "model": ""
          },
          "description": "Automatic skill-selection decisions connection. Configure it in the sidebar connection settings.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "useMainConnection": {
              "type": "boolean"
            },
            "format": {
              "type": "string",
              "enum": [
                "typesafe",
                "openai"
              ]
            },
            "baseUrl": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        },
        "deepseekHarness.skillSelectionThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum yes probability for automatic skill selection. Tune for your decisions model."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean-output.mjs",
    "compile": "npm run clean && npm run build:webview && npm run build:plugins && tsc -p .",
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:plugins": "tsdown plugins/dsh-otel-plugin/src/index.ts --format esm --out-dir out/plugins/dsh-otel-plugin --clean",
    "check:webview": "svelte-check --tsconfig ./tsconfig.webview.json",
    "watch:webview": "vite build --watch --config vite.webview.config.ts",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node --test out/test/prompt-context.test.js out/test/browser-context.test.js out/test/user-question.test.js out/test/model-catalog.test.js out/test/mcp.test.js out/test/control-bridge.test.js out/test/dsh-control-plugin.test.js out/test/harness-runtime.test.js out/test/session-controller.test.js out/test/session-hierarchy.test.js out/test/serial-task-queue.test.js out/test/streamed-step-tracker.test.js out/test/compaction-history.test.js out/test/live-tool-call-tracker.test.js out/test/request-preview-view.test.js out/test/reasoning-effort-request.test.js out/test/decision-client.test.js out/test/skill-controller.test.js out/test/dsh-skill-bridge.test.js out/test/decision-settings.test.js out/test/skills-runtime.test.js",
    "package": "npm run compile && node scripts/package-extension.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check:storybook": "svelte-check --tsconfig ./tsconfig.storybook.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@grpc/grpc-js": "^1.14.3",
    "@lucide/svelte": "^1.43.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "basecoat-css": "^1.0.2",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/svelte-vite": "^10.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.100.0",
    "storybook": "^10.6.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "enabledApiProposals": [
    "browser"
  ],
  "overrides": {
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-crypto": "0.1.5-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "0.1.5-rc.1",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.1"
  }
}
